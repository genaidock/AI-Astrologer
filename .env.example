# ── Option 1: Coolify on Oracle Server (Ollama on Host) ───────────────────
# Inside Coolify Docker, host.docker.internal reaches the Oracle host's Ollama:
LLM_API_BASE=http://host.docker.internal:11434/v1
LLM_MODEL=qwen3.6-35b
LLM_API_KEY=ollama
# Disable internal thinking tokens for fast (5-15s) horoscope/tarot responses:
LLM_THINK=false
LLM_TIMEOUT=300

# ── Option 2: Local Development with Host Ollama ──────────────────────────
# LLM_API_BASE=http://localhost:11434/v1
# LLM_MODEL=qwen3.6-35b
# LLM_API_KEY=ollama
# LLM_THINK=false

# ── Option 3: External API (CodeCraft, OpenAI, Groq, OpenRouter) ─────────
# LLM_API_BASE=https://codecraftapi.com/v1
# LLM_API_KEY=your_api_key_here
# LLM_MODEL=deepseek-v4-pro-max

# ── Server Configuration ──────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=*
