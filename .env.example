# ── Option 1: OmniRoute (Oracle Server — ACTIVE) ──────────────────────────
# OmniRoute is deployed on Oracle server (port 20128) and proxies all AI models.
# Use this when running both AI Astrologer and OmniRoute on the same server.
LLM_API_BASE=http://130.210.19.223:20128/v1
LLM_API_KEY=sk-531aab8980af0e5a-7eba2f-22a14bc8
LLM_MODEL=auto
# LLM_THINK=false
# LLM_TIMEOUT=120

# ── Option 2: Coolify on Oracle Server (Ollama on Host) ───────────────────
# Inside Coolify Docker, host.docker.internal reaches the Oracle host's Ollama:
# LLM_API_BASE=http://host.docker.internal:11434/v1
# LLM_MODEL=qwen3.6-35b
# LLM_API_KEY=ollama
# LLM_THINK=false
# LLM_TIMEOUT=300

# ── Option 3: Local Development with Host Ollama ──────────────────────────
# LLM_API_BASE=http://localhost:11434/v1
# LLM_MODEL=qwen3.6-35b
# LLM_API_KEY=ollama
# LLM_THINK=false

# ── Option 4: External API (CodeCraft, OpenAI, Groq, OpenRouter) ─────────
# LLM_API_BASE=https://codecraftapi.com/v1
# LLM_API_KEY=your_api_key_here
# LLM_MODEL=deepseek-v4-pro-max

# ── Server Configuration ──────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=*
